# Generic bidi-health app config.
#
# At deploy time, copy this to apps.yaml and edit. Two app kinds via probe_type:
#
#   probe_type: bidi (default) — ADK bidi WebSocket app. Produces:
#     GET /check/{name}/live         text probe
#     GET /check/{name}/live/audio   audio probe (TTS-synthesized PCM input)
#   Must follow the ADK bidi-demo protocol:
#     WebSocket path: /ws/{user_id}/{session_id}
#     Text frame:     {"type":"text","text":"..."}
#     Audio frame:    raw 16kHz 16-bit PCM mono binary
#     Events:         ADK Event JSON (camelCase via by_alias=True)
#
#   probe_type: cuj — ADK-workflow app with an HTTP/SSE endpoint. Produces:
#     GET /check/{name}/cuj          drives one end-to-end CUJ via POST /api/chat
#   Succeeds on a WorkflowComplete SSE event (no terminal error frame). Doubles
#   as a keep-warm call for backends that scale to zero (Agent Engine).

defaults:
  text_timeout_seconds: 20
  audio_timeout_seconds: 30
  cuj_timeout_seconds: 60
  tts_voice:
    language_code: en-US
    ssml_gender: NEUTRAL  # one of: NEUTRAL, MALE, FEMALE

apps:
  - name: bidi-demo-prod
    ws_url: wss://bidi-demo-761793285222.us-east1.run.app
    query: "What time is it in Tokyo?"

  # Audio-only app (text input is silently dropped server-side).
  # Sends a setup JSON frame before audio. Selects language pair via URL query.
  - name: adk-live-translator-prod
    ws_url: wss://live-translation-761793285222.us-central1.run.app
    ws_query_params:
      source: en
      target: ja
    setup_message: '{"glossary":[]}'
    text_probe_enabled: false
    query: "What time is it in Tokyo?"
    # Audio of "What time is it in Tokyo?" is translated to Japanese; expect
    # "東京" in outputTranscription. Set the Cloud Monitoring matcher to "東京".

  # Hotel concierge app — audio-only (response modality is AUDIO, so text
  # input returns no transcribable text). Pick a query whose response
  # reliably contains a hotel-specific keyword to use as the Cloud
  # Monitoring matcher (e.g. "Las Vegas").
  - name: grounding-demo-prod
    ws_url: wss://grounding-demo-761793285222.us-east1.run.app
    text_probe_enabled: false
    query: "Where is your hotel?"

  # Non-English app: both text and audio probes work, but the audio probe
  # needs a matching TTS voice so the app's input transcription recognizes the
  # synthesized query. tts_voice overrides the global default for this app only.
  # Pick a matcher word from a deterministic response (e.g. an agent's fixed
  # self-introduction) rather than flaky search/tool output.
  - name: casestudiesforest-prod
    ws_url: wss://casestudiesforest-live-136865672131.us-central1.run.app
    query: "こんにちは。あなたのお名前は？"  # response contains "もりのくま" / "事例の森"
    audio_timeout_seconds: 45
    tts_voice:
      language_code: ja-JP
      ssml_gender: NEUTRAL

  # CUJ probe: an ADK-workflow app behind HTTP/SSE (not a bidi WebSocket).
  # Drives one end-to-end Critical User Journey via POST /api/chat and succeeds
  # on a WorkflowComplete event. Also keeps scale-to-zero backends (Agent
  # Engine) warm. Set the Cloud Monitoring matcher to a word from the final
  # report (e.g. "SUCCESS").
  - name: scale-control-room-prod
    probe_type: cuj
    http_url: https://scale-control-room-761793285222.us-central1.run.app
    query: "Restock 2 Google Droid figures for the Tokyo office"
    cuj_timeout_seconds: 60

  # Example with optional overrides:
  # - name: other-bidi-app
  #   ws_url: wss://other.example.com
  #   query: "What's the weather in Paris?"
  #   audio_query: "Tell me the weather in Paris"  # separate audio phrase
  #   text_timeout_seconds: 30                      # per-app timeout override
